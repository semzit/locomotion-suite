<mujoco model="simple_humanoid">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" density="1000"/>

  <default>
    <geom type="box" friction="0.8 0.02 0.01"/>
    <joint damping="0.5"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.01" rgba="0.5 0.5 0.5 1"/>

    <body name="torso" pos="0 0 1.2">
      <freejoint name="root"/>
      <geom name="torso_geom" size="0.1 0.08 0.2"/>

      <body name="leg_l_upper" pos="0 0.1 0">
        <joint name="hip_l" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom name="thigh_l" size="0.06 0.06 0.25" pos="0 0 -0.25"/>
        <body name="leg_l_lower" pos="0 0 -0.5">
          <joint name="knee_l" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
          <geom name="shin_l" size="0.05 0.05 0.25" pos="0 0 -0.25"/>
          <body name="foot_l" pos="0 0 -0.5">
            <joint name="ankle_l" type="hinge" axis="0 1 0" range="-0.5 0.5"/>
            <geom name="foot_geom_l" size="0.08 0.04 0.1" pos="0.03 0 -0.1"/>
          </body>
        </body>
      </body>

      <body name="leg_r_upper" pos="0 -0.1 0">
        <joint name="hip_r" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom name="thigh_r" size="0.06 0.06 0.25" pos="0 0 -0.25"/>
        <body name="leg_r_lower" pos="0 0 -0.5">
          <joint name="knee_r" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
          <geom name="shin_r" size="0.05 0.05 0.25" pos="0 0 -0.25"/>
          <body name="foot_r" pos="0 0 -0.5">
            <joint name="ankle_r" type="hinge" axis="0 1 0" range="-0.5 0.5"/>
            <geom name="foot_geom_r" size="0.08 0.04 0.1" pos="0.03 0 -0.1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="hip_l" joint="hip_l" gear="100"/>
    <motor name="knee_l" joint="knee_l" gear="100"/>
    <motor name="ankle_l" joint="ankle_l" gear="100"/>
    <motor name="hip_r" joint="hip_r" gear="100"/>
    <motor name="knee_r" joint="knee_r" gear="100"/>
    <motor name="ankle_r" joint="ankle_r" gear="100"/>
  </actuator>
</mujoco>
